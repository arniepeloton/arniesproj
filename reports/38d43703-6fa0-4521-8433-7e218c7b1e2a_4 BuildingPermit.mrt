          <Page isRef="780" />
          <Parent isRef="780" />
          <Text>8)</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text490>
        <Text491 Ref="851" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.3,12.2,7.4,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,7</Font>
          <Guid>ff30dc07e8294e49b4138779186e3e94</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text491</Name>
          <Page isRef="780" />
          <Parent isRef="780" />
          <Text>THE OWNER/PERMITTEE SHALL PUT A BUILDING PERMIT SIGN WHICH COMPLIES WITH THE PRESCRIBED DIMENSIONS AND INFORMATION, WHICH SHALL REMAIN POSTED ON THE CONSTRUCTION SITE FOR THE DURATION OF THE CONSTRUCTION.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
