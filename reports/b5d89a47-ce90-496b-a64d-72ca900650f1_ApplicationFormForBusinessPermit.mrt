          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>APPLICATION FORM FOR BUSINESS PERMIT
TAX YEAR ____________________
CITY GOVERNMENT OF DAVAO</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1>
        <Text2 Ref="6" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,0.6,1.4,0.2</ClientRectangle>
