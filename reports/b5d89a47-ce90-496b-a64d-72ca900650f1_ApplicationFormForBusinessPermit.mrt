          <Margins>0,0,0,0</Margins>
          <Name>Text2</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>INSTRUCTIONS:</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text2>
        <Text3 Ref="7" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,0.8,7.8,0.5</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>3af8b9606c494715b06ef7f776131962</Guid>
          <HorAlignment>Width</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text3</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>PROVIDE ACCURATE INFORMATION AND PRINT LEGIBLY TO AVOID DELAYS, INCOMPLETE APPLICATION FORM WILL BE RETURNED TO THE APPLICANT, ENSURE THAT ALL DOCUMENTS ATTACHED TO THIS FORM (IF ANY) ARE COMPLETE AND PROPERLY FILLED OUT.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
