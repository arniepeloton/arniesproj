              <Margins>0,0,0,0</Margins>
              <Name>Text1</Name>
              <Page isRef="7" />
              <Parent isRef="81" />
              <Text>{(Data.BegBal + Data.PrevGrossSales - (Data.PrevTotalSCDiscount + Data.PrevSoloParentDiscount + Data.PrevTotalDiscount) - Data.PrevSalesReturnRefund - Data.PrevSalesReturnExchange - Data.PrevVATExempt + Data.PrevChargeAmount + Data.PrevServiceCharge 
//+ Data.PrevSRVAmount
) + (Data.CurGrossSales - (Data.TotalSCDiscount + Data.TotalSoloParentDiscount + Data.CurTotalDiscount) - Data.CurSalesReturnRefund - Data.CurSalesReturnExchange - Data.CurVATExempt + Data.ChargeAmount + Data.CurServiceCharge 
//+ Data.SRVAmount
)}</Text>
              <TextBrush>Black</TextBrush>
              <TextFormat Ref="138" type="NumberFormat" isKey="true">
                <GroupSeparator>,</GroupSeparator>
                <NegativePattern>1</NegativePattern>
              </TextFormat>
              <Type>Expression</Type>
