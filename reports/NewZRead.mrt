              <HorAlignment>Right</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text12</Name>
              <Page isRef="7" />
              <Parent isRef="81" />
              <Text>{(Data.CashAmount - Decimal.Parse(Data.CashRefund))
+ (Data.CheckPaymentAmount + Data.CurPotatoCornerGC)
+ (Data.DebitCardAmount - Decimal.Parse(Data.DebitRefund))
+ (Data.CreditCardAmount - Decimal.Parse(Data.CreditRefund))
+ (Data.SRVAmount)
+ (Data.OnCreditAmount)
+ Decimal.Parse(Data.TotalOtherPayments)}</Text>
              <TextBrush>Black</TextBrush>
              <TextFormat Ref="141" type="NumberFormat" isKey="true">
                <GroupSeparator>,</GroupSeparator>
                <NegativePattern>1</NegativePattern>
              </TextFormat>
