              <Name>Text96</Name>
              <Page isRef="7" />
              <Parent isRef="18" />
              <Text>Sales Discount:</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text96>
            <Text97 Ref="26" type="Text" isKey="true">
              <Brush>Transparent</Brush>
