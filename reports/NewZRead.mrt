              <HorAlignment>Right</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text97</Name>
              <Page isRef="7" />
              <Parent isRef="18" />
              <Text>{(Data.TotalSCDiscount 
- Decimal.Parse(Data.DiscountRefund)
) + Data.TotalSoloParentDiscount + Data.CurTotalDiscount}</Text>
