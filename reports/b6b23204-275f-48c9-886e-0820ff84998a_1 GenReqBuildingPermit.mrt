          <Guid>88b24b1a9a4f4e7a9050eca4c2794706</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text52</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>1. Application Letter with duly filled-up forms of the following: [Sec. 302]</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text52>
        <Text53 Ref="49" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>4.6,5.3,3.1,0.6</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>65e507697b65467e97399296cabec643</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text53</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>2. Building Permit Form with 6-7 sets of Civil/Architectural Plans duly signed and sealed by a licensed Civil Engineer/Archiect [Sec. 302.3.b-c, Sec. 302.4-5]</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text53>
        <Text54 Ref="50" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>4.6,5.9,3.1,0.7</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>6f1b0440af024e9f9b5b92e8cbe8b5e3</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text54</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>3. Sanitary/Plumbing Permit Form with 6-7 sets Plumbing Plans duly signed and sealed by licensed Sanitary Engineer/Master Plumber [Sec 302.3.g, Sec 302.]</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text54>
        <Text55 Ref="51" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>4.6,6.6,3.1,0.9</ClientRectangle>
          <Conditions isList="true" count="0" />
