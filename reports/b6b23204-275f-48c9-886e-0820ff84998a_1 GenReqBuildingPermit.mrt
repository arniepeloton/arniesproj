          <Guid>d839decd81e44585815100a9aea8c0af</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text55</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>4. Electrical Permit Form with 6-7 sets Electrical Plans duly signed and sealed by a licensed (Registered Professional) Electrical Engineer/Electronic Engineer [Sec 302.3.d, Sec 302.6]</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text55>
