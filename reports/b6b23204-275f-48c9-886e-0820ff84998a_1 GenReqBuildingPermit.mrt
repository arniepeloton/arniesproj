          <Font>Arial,10</Font>
          <Guid>9ec1348305124a0bb191be6b99494524</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text56</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>6. Mechanical Permit Form with 6-7 sets of mechanical plans signed and sealed by a licensed mechanical engineer.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
