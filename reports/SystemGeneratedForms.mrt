          <Margins>0,0,0,0</Margins>
          <Name>Text1058</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>THIS PERMIT MAY BE CANCELLED OR REVOKED PERSUANT TO SECTION 305 &amp; 306 OF THE "NATIONAL BUILDING CODE".</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text1058>
