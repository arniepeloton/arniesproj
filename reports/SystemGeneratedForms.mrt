          <Margins>0,0,0,0</Margins>
          <Name>Text180</Name>
          <Page isRef="852" />
          <Parent isRef="852" />
          <Text>Delegate personnel for the implementation of safety</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text180>
        <Text181 Ref="861" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1,2.7,5.5,0.4</ClientRectangle>
