          <HorAlignment>Center</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text635</Name>
          <Page isRef="1844" />
          <Parent isRef="1844" />
          <Text>NOTE: THIS PERMIT MAY BE CANCELLED OR REVOKED PURSUANT TO SECTIONS 305 AND 306 OF THE NATION BUILDING CODE</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text635>
