          <Name>Text499</Name>
          <Page isRef="1702" />
          <Parent isRef="1702" />
          <Text>known as the Revised Penal Code of the Philippines.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text499>
