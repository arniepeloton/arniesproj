        <Text189 Ref="869" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1,5.5,5.5,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>b77f5321ab8843d9b4b2e5f634a5bb0a</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text189</Name>
          <Page isRef="852" />
          <Parent isRef="852" />
          <Text>Complies with all the regulations as well as safe work practices and safety rules.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
