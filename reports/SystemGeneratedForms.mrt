          <Margins>0,0,0,0</Margins>
          <Name>Text179</Name>
          <Page isRef="852" />
          <Parent isRef="852" />
          <Text>Responsible in operation, safety and health of the entire project.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text179>
        <Text180 Ref="860" type="Text" isKey="true">
          <Brush>Transparent</Brush>
