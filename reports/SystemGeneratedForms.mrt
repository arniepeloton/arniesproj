          <Margins>0,0,0,0</Margins>
          <Name>Text497</Name>
          <Page isRef="1702" />
          <Parent isRef="1702" />
          <Text>falsification on the supporting document in any way will cause disapproval of the permit application without</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text497>
        <Text498 Ref="1720" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,6.2,6.5,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
