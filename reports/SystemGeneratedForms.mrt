          <Margins>0,0,0,0</Margins>
          <Name>Text1046</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>BOX 2 (TO BE ACCOMPLISHED BY THE BUILDING OFFICIAL)</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1046>
        <Text1047 Ref="3969" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,11.2,1,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>abba0330df754caf814cd9e097637110</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1047</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>ACTION TAKEN</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1047>
        <Text1048 Ref="3970" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,11.4,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>af80aacb79d243a1a2ffe7b9a6f6668f</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1048</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>Permit is hereby granted to install the sanitary/plumbing fixture enumerated herein subject to the following condition.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text1048>
        <Text1049 Ref="3971" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,11.7,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>acfbd7c04a1a4b38ad3d6fd350d8c7bf</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1049</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>1</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1049>
        <Text1050 Ref="3972" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,11.7,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>72eec005786e4a8792d4d44efe65ac58</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1050</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>That the proposed installation shall be in accordance with approved plans filed with this office and in conformly with the National Building Code.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text1050>
        <Text1051 Ref="3973" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,12,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>0a67c56b5e694027b126e1bd43cb93da</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1051</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>2</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1051>
        <Text1052 Ref="3974" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,12,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>0e9b12d4acf340fe85e73f183c08d999</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1052</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>That's duly licensed sanitary engineer/master plumber be engaged to undertake the installation/construction.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text1052>
        <Text1053 Ref="3975" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,12.3,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>40d0d3fb714e49a7a42822397d9ec9e2</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1053</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>3</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1053>
        <Text1054 Ref="3976" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,12.3,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>b81df71a3b6a46f88b1c220c15a79873</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1054</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>That the Certificate of Completion duly signed by sanitary/engineer/master plumber in-charge of installation shall be submitted not later than seven (7) days after completion of the installation.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text1054>
        <Text1055 Ref="3977" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,12.6,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>2f4f76bf576648c48cd4ad5d372eddce</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1055</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>4</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text1055>
        <Text1056 Ref="3978" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,12.6,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>ee65071809b84553ac510aeec29b1964</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text1056</Name>
          <Page isRef="3868" />
          <Parent isRef="3868" />
          <Text>That a certificate of final inspection and a Certificate of Occupancy be secured prior to the occupancy of the building.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text1056>
