    <Page8 Ref="938" type="Page" isKey="true">
      <Border>None;Black;2;Solid;False;4;Black</Border>
      <Brush>Transparent</Brush>
      <Components isList="true" count="43">
        <Text200 Ref="939" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>6.3,0,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>756fee0034e346b39902e877e532c63b</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text200</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>4</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text200>
        <Text201 Ref="940" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,0.2,2.5,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11,Bold</Font>
          <Guid>66cd4e4b8741477887199cbf374702ac</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text201</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>7.0 Personal Protective Equipment</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text201>
        <Text202 Ref="941" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,0.5,6.3,0.5</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>3726d8efd89c47b0accac92e736b7330</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text202</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>	The company will provide the following basic PPEs and enforce the use of adequate and approved type of personal protective clothing and equipment suited to the risk inherent in the work and operations performed:</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text202>
        <Text203 Ref="942" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.1,5.6,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>910ddbb3cdbd48628a761a6296215427</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text203</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>Safety shoes - will be used for general works and to be worn at all times on the site.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text203>
        <Text204 Ref="943" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.5,5.6,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>910481121e2f492fa2e1b8c3b9b82c7f</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text204</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>Safety helmet - all workers must wear an approved safety helmet while on the construction site.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text204>
        <Text205 Ref="944" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.9,5.6,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>7c456a4399cb4f67af162509a86bf9ac</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text205</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>Safety gloves - to be worn wherever possible for hand protection</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text205>
        <Text206 Ref="945" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,2.2,5.6,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>7f2852854164487f9b7599fd50c815ac</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text206</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>Safety goggles/Face shield -  protection against flying objects from doing work such as chipping, grinding, cutting, drilling works and alike.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text206>
        <Text207 Ref="946" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,2.6,5.6,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>4b8c73bc23c84024839b27b6c8fa9354</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text207</Name>
          <Page isRef="938" />
          <Parent isRef="938" />
          <Text>Safety belt/harness - to be used whenever working at height.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text207>
        <Text208 Ref="947" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,2.9,5.6,0.6</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>dc599090120b480f893a41a0a5522b1d</Guid>
          <Margins>0,0,0,0</Margins>
