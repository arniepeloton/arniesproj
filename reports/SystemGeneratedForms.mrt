          <Page isRef="852" />
          <Parent isRef="852" />
          <Text>c. Worker</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text187>
        <Text188 Ref="868" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1,5.1,5.5,0.4</ClientRectangle>
