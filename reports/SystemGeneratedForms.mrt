          <Margins>0,0,0,0</Margins>
          <Name>Text495</Name>
          <Page isRef="1702" />
          <Parent isRef="1702" />
          <Text>transact the application with your Office in my behalf.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text495>
        <Text496 Ref="1718" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.6,5.8,5.9,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Times New Roman,11</Font>
          <Guid>efbf1f409b6e4289b608b9cb02ddf41a</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text496</Name>
          <Page isRef="1702" />
          <Parent isRef="1702" />
          <Text>I/We hereby certify that the documents submitted herein are all true and correct, therefore</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text496>
        <Text497 Ref="1719" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,6,6.9,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
