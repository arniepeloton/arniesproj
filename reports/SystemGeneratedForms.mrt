          <Margins>0,0,0,0</Margins>
          <Name>Text498</Name>
          <Page isRef="1702" />
          <Parent isRef="1702" />
          <Text>prejudice to further action that may be undertaken pursuant to Article 171 &amp; 172 of R.A. 3815, otherwise</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text498>
        <Text499 Ref="1721" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,6.4,6.5,0.2</ClientRectangle>
