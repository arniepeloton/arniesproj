          <Margins>0,0,0,0</Margins>
          <Name>Text790</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>PERMIT ISSUED:</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text790>
