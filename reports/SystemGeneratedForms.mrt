          <Margins>0,0,0,0</Margins>
          <Name>Text1</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>A. General Requirements</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text1>
        <Text2 Ref="6" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,0.5,3.1,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,12</Font>
          <Guid>4fab0f8534434301b9421bd2f989db98</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text2</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>a. Two (2) copies of letter of intent.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text2>
        <Text3 Ref="7" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,0.7,4.7,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,12</Font>
          <Guid>6bf5bf21a57645878615a6de56bc3d90</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text3</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>b. Name of authorized contact person with telephone number/s.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text3>
        <Text4 Ref="8" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,0.9,4.6,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,12</Font>
          <Guid>9505abf99e0340d58941c722fd1c9db3</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text4</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>c. Two (2) copies of the Safety and Health Program. One copy must be original print.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text4>
        <Text5 Ref="9" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,1.4,3.6,0.2</ClientRectangle>
