          <Guid>20bcd83e62b1406baa37aa5ce12cbc6a</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text774</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>BOX 3</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text774>
        <Text775 Ref="3395" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,7.3,7.5,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>482e80a5061a48fa9e35607e6001ea29</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text775</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>PERMIT IS HEREBY GRANTED TO INSTALL THE ELECTRICAL WIRING, DEVICES AND EQUIPMENT ENUMERATED IN THIS APPLICATION SUBJECT TO THE FOLLOWING</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text775>
        <Text776 Ref="3396" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,7.7,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>1eda277a9d4d4c5ab77b5acb45b38070</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text776</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>1</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text776>
        <Text777 Ref="3397" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,7.7,7,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>2d537af588ab4dd28ea38ec4915c9b3f</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text777</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That the proposed electrical works shall be in accordance with the electrical plans filed with this Office in conformity with provisions of the latest Philippine Electrical Codes, the National Building Code and its IRR.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text777>
        <Text778 Ref="3398" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,8.1,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>00d25ea63be54b7a8a635ec54d077ad2</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text778</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>2</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text778>
        <Text779 Ref="3399" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,8.1,7,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>004e44bc595345f5a168342d43f1165a</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text779</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That prior to any electrical isntallation, the Owner/Permitee shall submit a duly accomplished prescribed Notice of Construction to the Office of the Building Council.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text779>
        <Text780 Ref="3400" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,8.5,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>0768e9cb635f4a4fa2d87dd24adf4c18</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text780</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>3</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text780>
        <Text781 Ref="3401" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,8.5,7,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>983301c0674743129d462473afd5c39e</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text781</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That for installed electrical capacity of 200 amperes and above at 230 volts nominal and above, a specialty electrical contractor duly licensed by the Philippine Contractors Accreditation Board (PCAB) shall be required.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text781>
        <Text782 Ref="3402" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,8.9,7,0.6</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>6bce429c4e3f435e8f961144fb1b0c70</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text782</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That a duly licensed electrical practitioner shall be in-charge of the installation and that upon completion of the electrical works, he shall submit the entry of the logbook duly signed and sealed to the OBO including as-built plans and other documents. He shall also accomplish the Certificate of Completion stating that the electrical works conform to the provision of the Philippine Electrical Codes, the National Building Code and its IRR.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text782>
        <Text783 Ref="3403" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,8.9,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>9b205c759eb74348aceae5281b06d14b</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text783</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>4</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text783>
        <Text784 Ref="3404" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,9.6,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>21cee90fb44c499bbedf70518c47d37c</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text784</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>5</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text784>
        <Text785 Ref="3405" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,9.6,7,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>7cbfb9f4b40049b3933d368b9e357084</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text785</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That this permit in null and void unless accompanied by the building permit except for projects involving purely electrical works in which case only the building permit number of the existing building/structure shall be required.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text785>
        <Text786 Ref="3406" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,10,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>67f52e19b1844873b3c9ed391875ad9b</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text786</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>6</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text786>
        <Text787 Ref="3407" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,10,7,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>aa1e3f5fffe244a0961ffea555fc19ce</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text787</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That a Certificate of Final Electrical Inspection (CFEI) shall be secured prior to the actual occupany of the building.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text787>
        <Text788 Ref="3408" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,10.3,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>608c398256d94524919d66bb3bfb03f6</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text788</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>7</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text788>
        <Text789 Ref="3409" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,10.3,7,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>298166aa2c5548fa805bbbe9de4992cc</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text789</Name>
          <Page isRef="3352" />
          <Parent isRef="3352" />
          <Text>That this permit shall be posted at the door or site work.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text789>
