          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>3.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text232>
        <Text233 Ref="992" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,1.8,5.3,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>137418dfbaf546d59e95e82f023a6039</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text233</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>Construction debris (broken hollow blocks, spoiled concrete, loose concrete, etc) should be taken out on the staging area.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text233>
        <Text234 Ref="993" type="Text" isKey="true">
          <Brush>Transparent</Brush>
