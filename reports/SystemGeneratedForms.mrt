          <Name>Text226</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>11.0 Construction Waste Disposal</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text226>
        <Text227 Ref="986" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,0.5,6.4,0.5</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>b05fcd6c99ab4d15bfcc9e1c7f837147</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text227</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>	The main constructor including subcontractors will be responsible for minimizing waste generated during the implementation of the project. The following procedures for disposal of wastes will be implemented in the site:</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text227>
        <Text228 Ref="987" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.1,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>002395a40cdd4e239854a286c7a0d992</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text228</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>1.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text228>
        <Text229 Ref="988" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,1.1,5.3,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>87d1ebae31254c569e201ae3c42ddfb4</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text229</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>Ensure that the construction wastes are segregated from that of domestic waste.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text229>
        <Text230 Ref="989" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.5,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>548a997e25b347a7bff8f23164be20c5</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text230</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>2.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text230>
        <Text231 Ref="990" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,1.5,5.3,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>728cd2eabe3d4699bb32bcece0d748f6</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text231</Name>
          <Page isRef="983" />
          <Parent isRef="983" />
          <Text>All domestic wastes are to be collected on a daily basis.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text231>
        <Text232 Ref="991" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.8,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
