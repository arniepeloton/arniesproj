          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>prejudice to further action that may be undertaken pursuant to Article 171 &amp; 172 of R.A. 3815, otherwise</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text21>
