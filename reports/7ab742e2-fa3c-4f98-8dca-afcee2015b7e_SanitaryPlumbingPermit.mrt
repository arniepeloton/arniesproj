          <Margins>0,0,0,0</Margins>
          <Name>Text110</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>That a certificate of final inspection and a Certificate of Occupancy be secured prior to the occupancy of the building.</Text>
          <TextBrush>Black</TextBrush>
