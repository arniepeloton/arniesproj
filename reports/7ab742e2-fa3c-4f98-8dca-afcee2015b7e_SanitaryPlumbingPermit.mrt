          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>1</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text103>
        <Text104 Ref="107" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,11.7,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>60b960405b424179b7b8726804146cf1</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text104</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>That the proposed installation shall be in accordance with approved plans filed with this office and in conformly with the National Building Code.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text104>
