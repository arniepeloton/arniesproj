        <Text102 Ref="105" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,11.4,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>5f3fe934036c410d8cd3bdd5f244958b</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text102</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>Permit is hereby granted to install the sanitary/plumbing fixture enumerated herein subject to the following condition.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text102>
