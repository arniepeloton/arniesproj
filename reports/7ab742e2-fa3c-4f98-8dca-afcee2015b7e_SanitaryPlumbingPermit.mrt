          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text105>
        <Text106 Ref="109" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,12,4.2,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,9</Font>
          <Guid>e63484ccd79842be9f93e0152217ea78</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text106</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>That's duly licensed sanitary engineer/master plumber be engaged to undertake the installation/construction.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
