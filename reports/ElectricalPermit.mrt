          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>5</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text52>
        <Text53 Ref="57" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,9.6,7,0.3</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>03e2f2fd3e49470daf5be669368fca82</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text53</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>That this permit in null and void unless accompanied by the building permit except for projects involving purely electrical works in which case only the building permit number of the existing building/structure shall be required.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text53>
        <Text54 Ref="58" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,10,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10,Bold</Font>
          <Guid>3f8459cb674d476688d1883a01230809</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text54</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>6</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text54>
        <Text55 Ref="59" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,10,7,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>16d7e6487cd54edf8725b06e42a99874</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text55</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>That a Certificate of Final Electrical Inspection (CFEI) shall be secured prior to the actual occupany of the building.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text55>
