          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>7</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text56>
        <Text57 Ref="61" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.4,10.3,7,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,10</Font>
          <Guid>23feaacabf344168af8df78803ad6fcf</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text57</Name>
          <Page isRef="4" />
          <Parent isRef="4" />
          <Text>That this permit shall be posted at the door or site work.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
