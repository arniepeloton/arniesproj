          <Margins>0,0,0,0</Margins>
          <Name>Text83</Name>
          <Page isRef="176" />
          <Parent isRef="176" />
          <Text>Delegate personnel for the implementation of safety</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text83>
        <Text84 Ref="185" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1,2.7,5.5,0.4</ClientRectangle>
