        </Text103>
        <Text104 Ref="264" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,0.2,2.5,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11,Bold</Font>
          <Guid>d5e9aa95a3b546a7997746472da80cc5</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text104</Name>
          <Page isRef="262" />
          <Parent isRef="262" />
          <Text>7.0 Personal Protective Equipment</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text104>
        <Text105 Ref="265" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.2,0.5,6.3,0.5</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>f05c9f4afa5c4e0b90d3e450040baf93</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text105</Name>
          <Page isRef="262" />
          <Parent isRef="262" />
          <Text>	The company will provide the following basic PPEs and enforce the use of adequate and approved type of personal protective clothing and equipment suited to the risk inherent in the work and operations performed:</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text105>
        <Text106 Ref="266" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.1,5.6,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>8524785909db484181e8b24dc342321e</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text106</Name>
          <Page isRef="262" />
          <Parent isRef="262" />
          <Text>Safety shoes - will be used for general works and to be worn at all times on the site.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text106>
        <Text107 Ref="267" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.5,5.6,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>0aa020f0854749d3a4d4546c818fbe9d</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text107</Name>
          <Page isRef="262" />
          <Parent isRef="262" />
          <Text>Safety helmet - all workers must wear an approved safety helmet while on the construction site.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text107>
        <Text108 Ref="268" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.9,5.6,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>fa1cb5bfd86a4f359ccaeeb7a868cd09</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text108</Name>
