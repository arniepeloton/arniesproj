          <Margins>0,0,0,0</Margins>
          <Name>Text82</Name>
          <Page isRef="176" />
          <Parent isRef="176" />
          <Text>Responsible in operation, safety and health of the entire project.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text82>
        <Text83 Ref="184" type="Text" isKey="true">
