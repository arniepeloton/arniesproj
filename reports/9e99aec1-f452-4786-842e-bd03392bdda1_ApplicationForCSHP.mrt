          <Margins>0,0,0,0</Margins>
          <Name>Text129</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>11.0 Construction Waste Disposal</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text129>
        <Text130 Ref="310" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.1,0.5,6.4,0.5</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>3661db4da39d4c2ab2a2c64025dce3c0</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text130</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>	The main constructor including subcontractors will be responsible for minimizing waste generated during the implementation of the project. The following procedures for disposal of wastes will be implemented in the site:</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text130>
        <Text131 Ref="311" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.1,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>60e1607c4fd54b819fa0bbff9f565488</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text131</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>1.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text131>
        <Text132 Ref="312" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,1.1,5.3,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>accab6767a2e48fbbefa9665611b31c7</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text132</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>Ensure that the construction wastes are segregated from that of domestic waste.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text132>
        <Text133 Ref="313" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.5,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>e44e8b239d224b0cb92d722f0a9c5a5c</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text133</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>2.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text133>
        <Text134 Ref="314" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,1.5,5.3,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>e051f364312d4f0985353a2ef91e1e62</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text134</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>All domestic wastes are to be collected on a daily basis.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text134>
        <Text135 Ref="315" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,1.8,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>1309c500f7d94876bd434c0174a15873</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text135</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>3.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text135>
        <Text136 Ref="316" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,1.8,5.3,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>b5ad63d372be4462afbf34524f5d9f6e</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text136</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>Construction debris (broken hollow blocks, spoiled concrete, loose concrete, etc) should be taken out on the staging area.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text136>
        <Text137 Ref="317" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0.9,2.2,0.2,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>2da97f2efaf44e0cb041326eb6d6b3f3</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text137</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>4.</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text137>
        <Text138 Ref="318" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.2,2.2,5.3,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>f12049a7b8f64583ba301e2ad7695f15</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text138</Name>
          <Page isRef="307" />
          <Parent isRef="307" />
          <Text>Oil spills and spoiled greases should be wrapping in the black garbage bag and will be properly disposed.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
