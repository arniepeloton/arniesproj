      <Components isList="true" count="45">
        <Text29 Ref="79" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,0.7,6.5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,12,Bold</Font>
          <HorAlignment>Center</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text29</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>CSHP TEMPLATE FOR RESIDENTIAL PROJECT/S (2 STOREY AND BELOW) OR MINOR REPAIR WORKS HAVING LESS THAN 10 WORKERS</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
          <VertAlignment>Center</VertAlignment>
        </Text29>
        <Text30 Ref="80" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,1.3,2.8,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11,Bold</Font>
          <Margins>0,0,0,0</Margins>
          <Name>Text30</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>1.0 Company Safety and Health Policy</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text30>
        <Text31 Ref="81" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,1.6,6.5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>0dd679a5b12f44e0ad75391787b3cd15</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text31</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>	It is the general policy of __________________________________ to perform work in the safest manner possible consistent with good construction practices.</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text31>
        <Text32 Ref="82" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,2,6.5,0.2</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>7860b55e2e0e4d4f8604ffd57c32300f</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text32</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>	To achieve these objectives, we are committed to the following:</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text32>
        <Text33 Ref="83" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.5,2.3,5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>ab5f0f12be6b4777852fe2c0629d4304</Guid>
          <HorAlignment>Width</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text33</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>Identified of potential hazards that may arise from the programmed/scheduled work activities;</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text33>
        <Text34 Ref="84" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.5,2.8,5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>590fcf78a4a54b58bb54150f55cb19ed</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text34</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>Organizing the work activities so as to minimize the risk arising from them;</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text34>
        <Text35 Ref="85" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.5,3.3,5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>28ed4b9a38484b5f8e00bcbd21322af9</Guid>
          <HorAlignment>Width</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text35</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>Ensuring that all workers are given orientation/briefing or induction prior to deployment to the site;</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text35>
        <Text36 Ref="86" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>1.5,3.8,5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>d895aece8c3a4862b0dc377332f265f4</Guid>
          <HorAlignment>Width</HorAlignment>
          <Margins>0,0,0,0</Margins>
          <Name>Text36</Name>
          <Page isRef="78" />
          <Parent isRef="78" />
          <Text>Establishing a site safety committee to act as policy making body of the project on all issues pertaining to safety and health;</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
          <Type>Expression</Type>
        </Text36>
