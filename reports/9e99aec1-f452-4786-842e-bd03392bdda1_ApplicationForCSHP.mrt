          <Page isRef="176" />
          <Parent isRef="176" />
          <Text>6.0 Conduct of Toolbox Meeting</Text>
          <TextBrush>Black</TextBrush>
          <Type>Expression</Type>
        </Text96>
        <Text97 Ref="198" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,7.1,6.5,0.4</ClientRectangle>
          <Conditions isList="true" count="0" />
          <Font>Arial,11</Font>
          <Guid>9be765bd85de46d68dc30a831a4a6a30</Guid>
          <Margins>0,0,0,0</Margins>
          <Name>Text97</Name>
          <Page isRef="176" />
          <Parent isRef="176" />
          <Text>	To hold a daily safety toolbox meeting every morning before the start of work to attain the following objectives:</Text>
          <TextBrush>Black</TextBrush>
          <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
