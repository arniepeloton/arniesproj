<html>
    <head>
        <title>Sales Order</title>
    </head>

    <body style="font-family:Arial; font-size:12px;">
        <div style="font-family:Arial; font-size:12px;">
            <table style="width:100%">
                <tr>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 30%;">
                        <div style="font-size:larger; font-weight:bolder;">SALES ORDER NO. </div> 
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 60%;">
                            <div id="lblSalesOrderNo" style="text-align: right; font-size:larger; font-weight:bolder;"> [SalesOrderNoHere]</div>
                    </td>
                </tr>
                <tr>
                <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 30%;">
                        <div>Order Date: </div>
                    </td>
                        
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style=" width: 60%;">
                            <div id="lblSalesOrderDateTime" style="text-align: right;">[SalesOrderDateHere]</div>

                    </td>
                </tr>
                    <tr>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 30%;">
                        <div>Sales Representative: </div>
                    </td>
                       
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style=" width: 60%;">
                            <div id="lblSalesRepName" style="text-align: right;">[SalesRepNameHere]</div>

                    </td>
                </tr>
            </table>
   
              
            <br />
                <table style="width:100%">
                <tr>
                <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 30%;">
                        <div style="font-size:larger; font-weight:bolder;">CUSTOMER: </div>
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style=" width: 60%;">
                            <div id="lblCustomerName" style="text-align: right; font-size:larger; font-weight:bolder;">[CustomerNameHere]</div>
                    </td>
                </tr>
                    <tr>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 30%;">
                        <div>Billing Address:</div> 
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 60%;">
                        <div id="lblCustomerBillingAddress" style="text-align: right; ">[BillingAddressHere]</div>
                    </td>
                </tr>
                <tr>
                <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 30%;">
                        <div>Delivery Address:</div> 
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 60%;">
                        <div id="lblCustomerDeliveryAddress" style="text-align: right; ">[DeliveryAddressHere]</div>

                    </td>
                </tr>
               
            </table>

        <br />
        <table style="width:100%">
            <thead>
                <tr style="background-color:ButtonFace;">
                    <td style="text-align:center; font-weight:bold; width: 2%; border: 1px solid Gray;">#</td>
                    <td style="text-align:center; font-weight:bold; width: 15%; border: 1px solid Gray;">Stock Number</td>
                    <td style="text-align:center; font-weight:bold; width: 30%; border: 1px solid Gray;">Stock Description</td>
                    <td style="text-align:center; font-weight:bold; width: 8%; border: 1px solid Gray;">Qty</td>
                    <td style="text-align:center; font-weight:bold; width: 15%; border: 1px solid Gray;">Unit Measure</td>
                    <td style="text-align:center; font-weight:bold; width: 15%; border: 1px solid Gray;">Unit Price</td>
                    <td style="text-align:center; font-weight:bold; width: 15%; border: 1px solid Gray;">Sub Total</td>
                </tr>
            </thead>

            [BodyGoesHere]

        </table>

        [FooterGoesHere]

       
          
            <br />
             <table style="width:100%">
                <thead>
                    <tr>
                        <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 30%;">
                                <div>Buyer / Purchaser:</div> 
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 60%;">
                                <div id="lblContactPerson" style="text-align: right; ">[PurchaserName]</div>

                            </td>
                        </tr>
                        <tr>
                        <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 30%;">
                                <div>Purchase Order No:</div> 
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 60%;">
                                <div style="text-align: right; ">[PurchaseOrderNo]</div>

                            </td>
                        </tr>
                        <tr>
                        <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 30%;">
                                <div>Purchase Order Date:</div> 
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 2%;">
                                    &nbsp;
                            </td>
                            <td style="width: 60%;">
                                <div style="text-align: right; ">[PurchaseOrderDate]</div>

                            </td>
                        </tr>
                 
              </thead>

           
            </table>
            <br />
            <table style="width:100%">
                <thead>

                    <tr>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                        <td style="text-align:left; width:30px;">Prepared By:</td>
                        <td style="width: 2%;">
                            &nbsp;
                    </td>
   
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                        <td style="text-align:right; width:60px;" id="lblUserID">[PreparedBy]</td>
                    </tr>
                    <tr>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                        <td style="text-align:left;  width:30px;">Ordered By:</td>
                        <td style="width: 2%;">
                            &nbsp;
                    </td>
                    
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                    <td style="width: 2%;">
                            &nbsp;
                    </td>
                        <td style="width: 2%;">
                            &nbsp;
                    </td>
                        <td style="text-align:right;  width:60px;" id="lblSalesRepNameOrder">[OrderedBy]</td>
                    </tr>
                </thead>

           
            </table>

        </div>

    </body>

    </html>
       [ScriptGoesHere]

       