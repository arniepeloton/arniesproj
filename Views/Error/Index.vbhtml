@Code
    Layout = "~/Views/Shared/_Layout.vbhtml"
End Code
<div class="container">
    <h2>Something's not right...</h2>

    <h2>But... It’s not you...</h2>

    <h2>It’s us!</h2>

     <img class="img-responsive" src="/Content/images/errorpagegeneral.jpg" />

     <br />
    <p>We’re experiencing some technical issues. Please reload the

    page you're trying to access or send us a quick heads up

    at customercare@mobiz-apps.com if the issue persists.
    </p>
 

    <p>Our server availability is from

    8:30 AM to 9:35 PM, Mondays to Sundays. 

    If you’re accessing our website after availability hours, try coming back again later.
    </p>
 

    <p>Thanks. :)</p>


    <br />
</div>