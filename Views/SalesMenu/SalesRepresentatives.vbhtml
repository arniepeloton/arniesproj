<div data-role="popup" id="popupSalesRepresentatives" data-theme="c" class="ui-corner-all">
    <a href="#" data-rel="back" data-role="button" data-theme="a" data-icon="delete" data-iconpos="notext" class="ui-btn-right">Close</a>
    <center>
        <h3>
            Assign Sales Representative</h3>
    </center>
    <div data-theme="c" style="margin: 0px 7px 0 7px;">
        <form>
        <input name="txtSearch" type="search" placeholder="Search a Sales Representative" value="" />
        </form>
        <ul data-role="listview" data-inset="true">
        </ul>
        <button name="butApplyAll">Assign to current cart items</button>
        <br />
    </div>
</div>
