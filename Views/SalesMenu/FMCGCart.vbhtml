<div style="padding:10px;">
    <div class="divTable autoheight">
        <div class="divTableRow">
            <div class="divTableCell"><input type="text" name="txtProductQty" class="form-control" data-role="none" autofocus="autofocus" placeholder="" /></div>
            <div class="divTableCell"><input type="text" name="txtProductSearch" class="form-control" data-role="none" placeholder="" /></div>
        </div>
    </div>
</div>
