<div class="divTable" style="background-color:#F7F7F7;">
    <div class="divTableRow">
        <div class="divTableCell">
            Sub Total
            <br />
            <span class="figure">-</span>
        </div>
        <div class="divTableCell">
            Unpaid Amount
            <br />
            <span class="figure">-</span>
        </div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell" id="btnFMCGDiscount" style="color:#008EFF;">
            Less: Discounts (Alt + D)
            <br />
            <span class="figure">-</span>
        </div>
        <div class="divTableCell">
            Total Amount Tendered
            <br />
            <span class="figure">-</span>
        </div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell" id="btnFMCGCharges" style="color:#008EFF;">
            Add: Charges (Alt + C)
            <br />
            <span class="figure">-</span>
        </div>
        <div class="divTableCell">
            Change Amount
            <br />
            <span class="figure">-</span>
        </div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell" style="color:#FF5722">
            Net Total
            <br />
            <span class="figure important">1,000.75</span>
        </div>
        <div class="divTableCell">
            Line Items / Total Qty
            <br />
            <span class="figure">-</span>
        </div>
    </div>
                
    <div class="divTableRow">
        <div class="divTableCell txt-middle" id="btnFMCGCash" style="color:#008EFF;">Cash (PgUp)</div>
        <div class="divTableCell txt-middle"><span class="figure important">-</span></div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell txt-middle" id="btnFMCGChequeGC" style="color:#008EFF;">Cheque/GC  (Alt + G)</div>
        <div class="divTableCell txt-middle"><span class="figure important">-</span></div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell txt-middle" style="color:#008EFF;">Cards (PgDn)</div>
        <div class="divTableCell txt-middle"><span class="figure important">-</span></div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell txt-middle" id="btnFMCGSrv" style="color:#008EFF;">SRV (Alt + V)</div>
        <div class="divTableCell txt-middle"><span class="figure important">-</span></div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell txt-middle" id="btnFMCGOtherPayment" style="color:#008EFF;">Other Payments (Alt + O)</div>
        <div class="divTableCell txt-middle"><span class="figure important">-</span></div>
    </div>
    <div class="divTableRow">
        <div class="divTableCell txt-middle">Print a name receipt</div>
    </div>
</div>