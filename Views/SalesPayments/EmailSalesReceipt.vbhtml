<html>

<head>
    <title>Receipt</title>
</head>

<body>
    <div style="font-family:Arial;">
        
        <table style="width:100%">
            <tr>
                <td style="text-align:left; width: 50%;">
                    <div style="font-size:x-large; font-weight:bolder;">[TradeNameHere]</div>
                </td>
                <td style="text-align:right; width: 50%;">
                    <div></div>
                </td>
            </tr>
            <tr>
                <td style="text-align:left; width: 50%;">
                    <div>[CorporateNameHere]</div>
                    <div>[TINHere]</div>
                    <div>[AddressHere]</div>
                    <div>[TelNoHere]</div>
                </td>
                <td style="text-align:right; width: 50%;">
                    <div style="font-size:larger; font-weight:bolder;">SALES INVOICE</div>
                    <div>[InvoiceNoHere]</div>
                    <div>[InvoiceDateTimeHere]</div>
                    <div>[CashierNameHere]</div>
                </td>
            </tr>
        </table>

        <br />
        <div>[POSAccreditationNo]</div>
        <div>[POSRegistrationNo]</div>
        <div>[POSMachineNo]</div>
    
        <br /><br />
        <div style="font-size:larger; font-weight:bolder;">CUSTOMER</div>
        <hr>
        <div>[CustomerNameHere]</div>
        <div>[CustomerAddressHere]</div>
        <div>[CustomerTINHere]</div>

        <br /><br />
        <div style="font-size:larger; font-weight:bolder;">SHIPPING DETAILS</div>
        <hr>
        <div>[CustomerBillingAddress]</div>
        <div>[CustomerDeliveryAddress]</div>


        <br /><br />
        <table style="width:100%">
            <thead>
                <tr style="background-color:ButtonFace;">
                    <td style="text-align:center; font-weight:bold; width: 35%; height:35px; border: 1px solid Gray;">Stock Description</td>
                    <td style="text-align:center; font-weight:bold; width: 10%; height:35px; border: 1px solid Gray;">Qty</td>
                    <td style="text-align:center; font-weight:bold; width: 15%; height:35px; border: 1px solid Gray;">Unit Measure</td>
                    <td style="text-align:center; font-weight:bold; width: 20%; height:35px; border: 1px solid Gray;">Unit Price</td>
                    <td style="text-align:center; font-weight:bold; width: 20%; height:35px; border: 1px solid Gray;">Sub Total</td>
                </tr>
            </thead>

            [BodyGoesHere]

        </table>

        [FooterGoesHere]

        <br /><br />
        <div style="font-size:larger; font-weight:bolder;">PAYMENT DETAILS</div>
        <hr>
        <div>[CASHPAYMENT]</div>
        <div>[CHECKPAYMENT]</div>
        <div>[CREDITCARDPAYMENT]</div>
        <div>[DEBITCARDPAYMENT]</div>
        <div>[SRVPAYMENT]</div>
        <div>[CHANGEAMOUNT]</div>

        <br />

        <div style="text-align:center;">This business is made more efficient by Mobiz.</div>
        <div style="text-align:center;">Visit us at www.mobiz-apps.com</div>


    </div>

</body>

</html>
