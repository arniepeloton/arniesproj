@Code    
    ViewData("Title") = "CRM Setup"
    Layout = "~/Views/Shared/Layout3Single.vbhtml"
End Code

    <script type="text/javascript" src="../../Scripts/sources/CRMSetup/root.js"></script>    

	    <div data-role="content" data-theme="d">
            <div>
                <h3> Welcome to the Employees Reward Module! </h3> <br />
                Good performance must be rewarded so as to encourage them. <br /> <br />
                Using this module, you will be able to
                set various parameters that will instruct our system on
                who, what, when and how employees are rewarded for
                their performance. <br /> <br />
                Just go back to this module to
                change the parameters you need to alter in the future            
            </div>

            <br /> <br />

			<div style="text-align:center"> <a href="#" id="Teams" data-role="button">Next</a> </div>

	    </div> <!-- /content -->	
