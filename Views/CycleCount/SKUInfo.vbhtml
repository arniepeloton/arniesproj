<html>
<head>
    <title>
        @Code
            ViewData("Title") = "SKU Info"
            Layout = "~/Views/CycleCount/CycleCountMaster.vbhtml"
        End Code
    </title>
    <script type="text/javascript" src="../../Scripts/sources/CycleCount/SKUInfo.js"></script>    
</head>
<body>
